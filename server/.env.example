PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lifeline?retryWrites=true&w=majority
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Used only by `npm run seed` to create the admin account.
ADMIN_NAME=LifeLine Admin
ADMIN_EMAIL=admin@lifeline.test
ADMIN_PASSWORD=change-me

# Optional. If SMTP_* are absent, an Ethereal test account is created automatically.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
